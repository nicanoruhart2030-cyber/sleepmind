# Copy to .env.local and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kimi (Moonshot) — same key works as MOONSHOT_API_KEY if you prefer that name.
KIMI_API_KEY=
# Optional: https://api.moonshot.ai/v1 (default) or https://api.moonshot.cn/v1
# KIMI_BASE_URL=
# Optional model id (default moonshot-v1-8k). Examples: kimi-k2-0711-preview, moonshot-v1-32k
# KIMI_MODEL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
