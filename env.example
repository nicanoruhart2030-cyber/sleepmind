# Copy to .env.local and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kimi (Moonshot) — same key works as MOONSHOT_API_KEY if you prefer that name.
KIMI_API_KEY=
# Optional: https://api.moonshot.ai/v1 (default) or https://api.moonshot.cn/v1
# KIMI_BASE_URL=
# Optional model id (default moonshot-v1-8k). Examples: kimi-k2-0711-preview, moonshot-v1-32k
# KIMI_MODEL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (fixes Error 400: redirect_uri_mismatch) ─────────────────────
#
# Google validates the redirect URI that SUPABASE sends (not your Next.js URL).
#
# 1) Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID (Web).
#
# 2) Authorized redirect URIs — add EXACTLY (replace YOUR_REF with the host in NEXT_PUBLIC_SUPABASE_URL):
#      https://YOUR_REF.supabase.co/auth/v1/callback
#    Example if URL is https://gwahvxujtdhfhretpabs.supabase.co :
#      https://gwahvxujtdhfhretpabs.supabase.co/auth/v1/callback
#    Do NOT put https://sleepmind.vercel.app/auth/callback here — that belongs in Supabase only (step 4).
#
# 3) Authorized JavaScript origins — add:
#      https://YOUR_REF.supabase.co
#    (and http://localhost:3000 for local testing if you open the app locally)
#
# 4) Supabase → Authentication → Providers → Google: paste Client ID + Secret, enable.
#
# 5) Supabase → Authentication → URL configuration → Redirect URLs — add YOUR APP callbacks:
#      http://localhost:3000/auth/callback
#      https://YOUR-PRODUCTION-DOMAIN/auth/callback
